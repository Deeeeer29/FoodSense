/* pages/fresh/index.wxss 生鲜果蔬识别结果页 */
.page__padding {
  height: 190rpx;
}

/* ===================== 识别结果卡 ===================== */
.result {
  display: flex;
  width: 726rpx;
  margin: 16rpx auto 0;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.result__img {
  flex: none;
  width: 210rpx;
  height: 210rpx;
  border-radius: 22rpx;
  background: #F5F6F4;
}

.result__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 28rpx;
}

.result__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #16241A;
}

.result__line {
  margin-top: 14rpx;
  font-size: 27rpx;
  color: #8A9390;
}

/* 「新鲜选择」胶囊 */
.fresh-pill {
  align-self: flex-start;
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 10rpx 24rpx 10rpx 18rpx;
  border-radius: 30rpx;
  background: linear-gradient(120deg, #5FCB7C 0%, #2EAE55 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.fresh-pill__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
}

/* ===================== 分段标签 ===================== */
.tabs {
  display: flex;
  align-items: center;
  padding: 26rpx 14rpx 6rpx;
}

.tabs__item {
  position: relative;
  flex: 1;
  padding: 16rpx 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #6C7772;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tabs__item--active {
  color: #16241A;
  font-weight: 700;
  background: #EAF7E8;
}

/* 激活态下方绿色短横线 */
.tabs__bar {
  width: 56rpx;
  height: 6rpx;
  margin-top: 8rpx;
  border-radius: 3rpx;
  background: #35BE62;
}

/* ===================== 卡片 ===================== */
.card {
  width: 726rpx;
  margin: 20rpx auto 0;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.card__body {
  padding: 30rpx 32rpx 34rpx;
}

.section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #16241A;
}

/* ===================== 选购技巧（编号列表） ===================== */
.tip {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}

.tip__index {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: linear-gradient(140deg, #5FCB7C, #2EAE55);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.tip__text {
  flex: 1;
  font-size: 28rpx;
  line-height: 46rpx;
  color: #4C5751;
}

.tip__label {
  color: #2EAE55;
  font-weight: 600;
}

/* ===================== 参考保质期 ===================== */
.storage {
  display: flex;
  margin-top: 24rpx;
}

.storage__item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
}

.storage__item + .storage__item {
  margin-left: 18rpx;
}

.storage__item--normal {
  background: #F2FAF0;
}

.storage__item--cold {
  background: #F1F2FC;
}

.storage__icon {
  flex: none;
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
}

.storage__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.storage__label {
  font-size: 26rpx;
  color: #6C7772;
}

.storage__value {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #16241A;
}

.storage__note {
  display: block;
  margin-top: 22rpx;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #A3AAA6;
}

.placeholder__text {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 44rpx;
  color: #8A9390;
}

/* ===================== 底部按钮 ===================== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -6rpx 20rpx rgba(20, 60, 35, 0.05);
}

.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(120deg, #46C46A 0%, #1FA84B 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary--hover {
  opacity: 0.9;
}

.btn-primary--basket {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.page__notice {
  margin-top: 26rpx;
}

.page__notice--above-footer {
  margin-bottom: 20rpx;
}