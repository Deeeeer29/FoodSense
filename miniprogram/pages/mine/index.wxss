/* pages/mine/index.wxss 我的（关于食察局） */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #F4F6F3;
}

/* ===================== 用户卡 ===================== */
.profile {
  display: flex;
  align-items: center;
  width: 726rpx;
  margin: 16rpx auto 0;
  padding: 30rpx 28rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.profile__avatar {
  flex: none;
  width: 140rpx;
  height: 140rpx;
}

.profile__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 26rpx;
}

.profile__name {
  font-size: 38rpx;
  font-weight: 700;
  color: #16241A;
}

.profile__id-row {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.profile__id {
  font-size: 26rpx;
  color: #8A9390;
}

/* 复制图标（纯 CSS：两个叠放的圆角方框） */
.profile__copy {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  margin-left: 14rpx;
  border: 3rpx solid #B6BDB9;
  border-radius: 6rpx;
}

.profile__copy::after {
  content: "";
  position: absolute;
  left: 5rpx;
  top: -8rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #B6BDB9;
  border-radius: 6rpx;
  background: #FFFFFF;
}

.profile__copy--hover {
  opacity: 0.6;
}

/* 会员等级徽标 */
.profile__badge {
  align-self: flex-start;
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 6rpx 20rpx 6rpx 12rpx;
  border-radius: 20rpx;
  background: #B6BDB9;
  color: #FFFFFF;
  font-size: 23rpx;
}

.profile__badge-crown {
  position: relative;
  width: 26rpx;
  height: 22rpx;
  margin-right: 8rpx;
}

.profile__badge-crown::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 26rpx;
  height: 14rpx;
  background: #FFFFFF;
  clip-path: polygon(0% 100%, 12% 0%, 50% 62%, 88% 0%, 100% 100%);
}

.profile__badge-crown::after {
  content: "";
  position: absolute;
  left: 2rpx;
  bottom: 2rpx;
  width: 22rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

/* 右侧箭头 */
.profile__arrow {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  margin-left: 12rpx;
  border-top: 4rpx solid #9AA3A0;
  border-right: 4rpx solid #9AA3A0;
  transform: rotate(45deg);
}

/* ===================== 数据入口 ===================== */
.stats {
  display: flex;
  width: 726rpx;
  margin: 20rpx auto 0;
  padding: 28rpx 12rpx 24rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
  border-radius: 18rpx;
}

.stat--hover {
  background: #F8FBF7;
}

.stat__icon {
  width: 84rpx;
  height: 84rpx;
}

.stat__label {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #3E4A44;
}

.stat__value {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8A9390;
}

/* ===================== 功能菜单 ===================== */
.menu {
  width: 726rpx;
  margin: 20rpx auto 0;
  border-radius: 26rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.menu__item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.menu__item + .menu__item {
  border-top: 2rpx solid #F3F6F2;
}

.menu__item--hover {
  background: #F8FBF7;
}

.menu__icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 26rpx;
}

.menu__label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #2A3630;
}

.menu__arrow {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-left: 12rpx;
  border-top: 4rpx solid #C7CDC9;
  border-right: 4rpx solid #C7CDC9;
  transform: rotate(45deg);
}

/* ===================== 版本与声明 ===================== */
.version {
  display: block;
  margin-top: 36rpx;
  font-size: 23rpx;
  color: #B6BDB9;
  text-align: center;
}

.page__notice {
  display: block;
  margin-top: 24rpx;
}