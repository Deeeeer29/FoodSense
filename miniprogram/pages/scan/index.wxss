/* pages/scan/index.wxss 拍照识别过渡页 */
.mode {
  display: flex;
  flex-direction: column;
  width: 726rpx;
  margin: 24rpx auto 0;
  padding: 40rpx 36rpx;
  border-radius: 26rpx;
  background: linear-gradient(140deg, #EAF9E4 0%, #FFFFFF 70%);
}

.mode__badge {
  align-self: flex-start;
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  background: #1FA84B;
}

.mode__badge--pack {
  background: #F4713A;
}

.mode__title {
  margin-top: 22rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #12351E;
}

.mode__desc {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 44rpx;
  color: #6C7772;
}

.section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #12351E;
}

.demo__text {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 44rpx;
  color: #5B6660;
}

.demo__actions {
  margin-top: 28rpx;
}

.btn-ghost {
  margin-top: 18rpx;
}

.flow__item {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.flow__dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin: 16rpx 18rpx 0 0;
  border-radius: 50%;
  background: #1FA84B;
}

.flow__text {
  flex: 1;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #5B6660;
}

.page__notice {
  margin-top: 32rpx;
}