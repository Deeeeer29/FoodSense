/* pages/analysis/index.wxss 包装食品识别结果页 */
.page__padding {
  height: 190rpx;
}

/* ===================== 产品信息卡 ===================== */
.product {
  display: flex;
  width: 726rpx;
  margin: 16rpx auto 0;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.product__img {
  flex: none;
  width: 190rpx;
  height: 258rpx;
  border-radius: 22rpx;
  background: #FCF1DF;
}

.product__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  margin-left: 26rpx;
}

.product__title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.product__name {
  flex: 1;
  margin-right: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 48rpx;
  color: #12351E;
}

/* 综合评价徽标 */
.grade {
  flex: none;
  display: flex;
  align-items: center;
  padding: 12rpx 14rpx 12rpx 16rpx;
  border-radius: 20rpx;
  background: #E7F7EB;
}

.grade--hover {
  opacity: 0.85;
}

.grade__icon {
  position: relative;
  flex: none;
  width: 40rpx;
  height: 44rpx;
  margin-right: 12rpx;
  border-radius: 8rpx 8rpx 20rpx 20rpx;
  background: linear-gradient(160deg, #7CCD82, #3FBF63);
}

.grade__icon::after {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 16rpx;
  width: 16rpx;
  height: 9rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  transform: rotate(-45deg);
}

.grade__text {
  display: flex;
  flex-direction: column;
}

.grade__label {
  font-size: 21rpx;
  line-height: 26rpx;
  color: #4C5751;
}

.grade__value {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 38rpx;
  color: #1B8A3D;
}

.grade__arrow {
  margin-left: 4rpx;
  font-size: 28rpx;
  color: #7FB48D;
}

.product__row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.product__label {
  width: 118rpx;
  flex: none;
  padding: 6rpx 0;
  border-radius: 8rpx;
  background: #F5F7F4;
  color: #8A9390;
  font-size: 25rpx;
  text-align: center;
}

.product__value {
  flex: 1;
  margin-left: 18rpx;
  font-size: 27rpx;
  color: #2A3630;
}

.product__desc {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 40rpx;
  color: #98A19C;
}

/* ===================== 分段标签 ===================== */
.tabs {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx 4rpx;
}

.tabs__item {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 30rpx;
  font-size: 27rpx;
  color: #6C7772;
  text-align: center;
}

.tabs__item--active {
  color: #1B8A3D;
  font-weight: 600;
  background: #E7F7EB;
}

/* ===================== 通用卡片 ===================== */
.card {
  width: 726rpx;
  margin: 20rpx auto 0;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.card__head {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 0;
}

.card__icon {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 18rpx;
}

.card__title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #12351E;
}

.card__sub {
  font-size: 25rpx;
  color: #98A19C;
}

.card__more {
  margin-left: auto;
  font-size: 25rpx;
  color: #98A19C;
}

.card__body {
  padding: 20rpx 32rpx 30rpx;
}

.card__note {
  display: block;
  margin-top: 22rpx;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #A3AAA6;
}

/* ===================== 配料表解析 ===================== */
.ingredient-text {
  font-size: 27rpx;
  line-height: 46rpx;
  color: #5B6660;
}

/* ===================== 添加剂行 ===================== */
.additive {
  display: flex;
  align-items: center;
  padding: 20rpx 20rpx;
  border-radius: 20rpx;
  background: #F8FAF7;
}

.additive + .additive {
  margin-top: 16rpx;
}

.additive--hover {
  background: #F1F6EE;
}

.additive__icon {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  margin-right: 20rpx;
}

.additive__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.additive__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2A3630;
}

.additive__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #98A19C;
}

.additive__arrow {
  flex: none;
  margin-left: 8rpx;
  font-size: 30rpx;
  color: #C7CDC9;
}

/* 风险胶囊标签 */
.pill {
  flex: none;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.pill--low {
  background: #35BE62;
}

.pill--medium {
  background: #F0AC29;
}

.pill--high {
  background: #EA6157;
}

.pill--unknown {
  background: #B6BDB9;
}

/* ===================== 营养成分 ===================== */
.nutri {
  display: flex;
}

.nutri__card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 6rpx;
  border-radius: 16rpx;
  background: #F6F8F5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nutri__card + .nutri__card {
  margin-left: 12rpx;
}

.nutri__label {
  font-size: 22rpx;
  color: #8A9390;
  white-space: nowrap;
}

.nutri__value-row {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.nutri__num {
  font-size: 27rpx;
  font-weight: 700;
  color: #2A3630;
}

.nutri__unit {
  margin-left: 4rpx;
  font-size: 20rpx;
  color: #8A9390;
}

.nutri__sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A3AAA6;
}

/* ===================== 风险评估 ===================== */
.risk {
  display: flex;
}

.risk__card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 14rpx;
  border-radius: 18rpx;
}

.risk__card + .risk__card {
  margin-left: 12rpx;
}

.risk__icon {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
}

.risk__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.risk__title {
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.risk__desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 30rpx;
  color: #7C857F;
}

/* ===================== 执行标准 ===================== */
.standard {
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  background: #F7FAF6;
}

.standard + .standard {
  margin-top: 18rpx;
}

.standard__code {
  font-size: 27rpx;
  font-weight: 700;
  color: #1B8A3D;
}

.standard__name {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #2A3630;
}

.standard__scope {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #8A9390;
}

.standard__note {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 36rpx;
  color: #A3AAA6;
}

/* ===================== 底部操作栏 ===================== */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -6rpx 20rpx rgba(20, 60, 35, 0.05);
}

.footer-bar--split {
  display: flex;
  align-items: center;
}

.btn-outline {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  border: 3rpx solid #1FA84B;
  background: #FFFFFF;
  color: #1B8A3D;
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-outline--hover {
  background: #F1F9F2;
}

.btn-outline__icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.btn-primary--scan {
  flex: 1;
  height: 88rpx;
  margin-left: 20rpx;
  border-radius: 44rpx;
  font-size: 29rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary__icon {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

.page__notice {
  margin-top: 26rpx;
}

.page__notice--above-footer {
  margin-bottom: 20rpx;
}